{
  "cleanUrls": false,
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/our-centres",
      "destination": "/our-centres/",
      "permanent": true
    },
    {
      "source": "/centres",
      "destination": "/our-centres/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/((?!tests/|locations/|our-centres/|images/|assets/|favicon|logo|robots\\.txt|sitemap.*\\.xml|llms.*\\.txt).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    },
    {
      "source": "/(images|assets)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
